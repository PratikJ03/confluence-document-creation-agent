# Docker ignore rules: prevent large, local, or sensitive files from being copied into the container image
.git/
.gitignore
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
.vscode/
.idea/
.claude/
.agents/
*.swp
*.swo
*.md5
*.token
*.db
tokens.json
credentials.json

