# Document Creation Agent — Confluence Publisher

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# Supported: bedrock (default) | google | openai | anthropic
# -----------------------------------------------------------------------------
LLM_PROVIDER=bedrock

# -----------------------------------------------------------------------------
# AWS Bedrock Configuration
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# -----------------------------------------------------------------------------
# Amazon OpenSearch Configuration
# Used for storing raw source notes, passage indexing, and final published doc indexing.
# For local dev / test mock mode, leave OPENSEARCH_ENDPOINT blank or mock.
# -----------------------------------------------------------------------------
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX_SOURCES=confluence-agent-sources
OPENSEARCH_INDEX_DOCS=confluence-agent-documents
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true

# -----------------------------------------------------------------------------
# Atlassian MCP Client Configuration (Model Context Protocol)
# -----------------------------------------------------------------------------
ATLASSIAN_MCP_ENABLED=true
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
ATLASSIAN_SITE_URL=
ATLASSIAN_MCP_TIMEOUT_SECONDS=30
ATLASSIAN_AUTH_TYPE=oauth
ATLASSIAN_USER_EMAIL=
ATLASSIAN_CLOUD_ID=
ATLASSIAN_DEFAULT_SPACE_ID=65679
ATLASSIAN_DEFAULT_JIRA_PROJECT=KAN
# Local: http://localhost:8501
# Deployed: set this to the exact public Streamlit URL, e.g. https://your-app.streamlit.app
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8501
CONFLUENCE_DEFAULT_SPACE=Dev
CONFLUENCE_PARENT_PAGE_ID=

# -----------------------------------------------------------------------------
# Generation Limits & Timeouts
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=4096
BEDROCK_MAX_TOKENS=4096

